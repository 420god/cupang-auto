{
  "manifest_version": 3,
  "name": "쿠팡윙 카테고리 상품 수집기",
  "version": "12.3.0",
  "description": "쿠팡 윙 카테고리별 상품 수집 + 소비자 페이지 판매량/배송유형 보강",
  "permissions": [
    "activeTab",
    "downloads",
    "notifications",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://wing.coupang.com/*",
    "https://www.coupang.com/*",
    "https://*.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://wing.coupang.com/*",
        "https://www.coupang.com/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://sourcing-web2.vercel.app/*"
    ]
  }
}